<style>
@import '../../common/styles/style.css';

/* 首页关键视觉完全归属本页：Vela 原生 Flex 布局，不依赖共享样式或 transform 位移。 */
.home-dice-area {
  flex: 1;
  flex-shrink: 1;
  min-height: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.home-die-img {
  width: 184px;
  height: 184px;
}

.home-die-img-shake {
  width: 184px;
  height: 184px;
  margin-left: -8px;
}

.home-result-wrap {
  width: 276px;
  height: 276px;
  align-items: center;
  justify-content: center;
}

.home-result-ticks {
  position: absolute;
  width: 276px;
  height: 276px;
}

.home-result-num {
  font-size: 124px;
  color: #ffffff;
  font-weight: bold;
}

.home-result-num-green {
  color: #2fbf6b;
}

.home-result-num-purple {
  color: #a980ff;
}

.home-result-sub {
  position: absolute;
  margin-top: 136px;
  font-size: 20px;
  color: #9a9ca3;
}

.home-hint {
  height: 32px;
  font-size: 20px;
  color: #9a9ca3;
  text-align: center;
  flex-shrink: 0;
}

.home-function-card {
  height: 56px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #1c1c21;
  border-radius: 16px;
  /* 大屏功能卡底边距 8px；小屏由下方宽度媒体查询覆盖。 */
  margin: 10px 16px 8px 16px;
  padding: 0 20px;
  flex-shrink: 0;
}

.home-function-label {
  font-size: 24px;
  color: #ffffff;
  font-weight: bold;
}

.home-function-chevron {
  font-size: 26px;
  color: #6f7178;
}

@media (max-width: 120) {
  .page {
    position: relative;
  }

  .home-dice-area {
    /* 为绝对定位的提示与功能入口预留垂直空间，防止 Flex 内容挤出屏幕。 */
    margin-bottom: 140px;
  }

  .home-die-img,
  .home-die-img-shake {
    width: 164px;
    height: 164px;
  }

  .home-die-img-shake {
    margin-left: -7px;
  }

  .home-result-wrap,
  .home-result-ticks {
    width: 224px;
    height: 224px;
  }

  .home-result-num {
    font-size: 106px;
  }

  .home-result-sub {
    margin-top: 108px;
    font-size: 18px;
  }

  .home-hint {
    height: 28px;
    font-size: 17px;
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 140px;
  }

  .home-function-card {
    height: 58px;
    /* 脱离 Flex 内容流，直接锚定在胶囊屏圆角上方的安全区。 */
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 74px;
    margin: 0px;
    padding: 0 16px;
  }

  .home-function-label {
    font-size: 22px;
  }
}
</style>

<template>
  <div class="page" onswipe="onSwipe">
    <!-- 顶栏：应用名 + 时钟（概念图·首页） -->
    <div class="topbar">
      <text class="app-name">CyberDice</text>
    </div>

    <!--
      主骰子区域：直接使用页面元素，和浏览器模拟器保持同一树结构。
      Vela 的自定义组件宿主不会自动继承 flex: 1，曾使骰子区域高度为 0。
    -->
    <div class="home-dice-area" onclick="onTapRoll">
      <block if="{{ rollState === 'RESULT' }}">
        <div class="home-result-wrap">
          <image class="home-result-ticks" src="/common/images/result-ticks.png"></image>
          <!-- 独立条件节点避免 Vela 在主题切换后复用旧 color。 -->
          <block if="{{ accent === 'blue' }}"><text class="home-result-num">{{ resultNum }}</text></block>
          <block if="{{ accent === 'green' }}"><text class="home-result-num home-result-num-green">{{ resultNum }}</text></block>
          <block if="{{ accent === 'purple' }}"><text class="home-result-num home-result-num-purple">{{ resultNum }}</text></block>
          <text class="home-result-sub" show="{{ resultSub !== '' }}">{{ resultSub }}</text>
        </div>
      </block>
      <block if="{{ rollState !== 'RESULT' }}">
        <!-- Vela 对同一 image 的 class/src 连续更新偶发不重绘；交替节点可确保每帧提交。 -->
        <block if="{{ jitter }}">
          <image class="home-die-img-shake" src="{{ dieSrc }}"></image>
        </block>
        <block if="{{ !jitter }}">
          <image class="home-die-img" src="{{ dieSrc }}"></image>
        </block>
      </block>
    </div>

    <text class="home-hint">{{ hint }}</text>

    <!-- 底部模式卡片 → 功能入口 -->
    <div class="home-function-card" onclick="goDiceSelect">
      <text class="home-function-label">{{ modeLabel }}</text>
      <text class="home-function-chevron">›</text>
    </div>
  </div>
</template>

<script>
const C = require('../../common/scripts/constants.js');
const diceEngine = require('../../common/scripts/dice-engine.js');
const sensorAdapterMod = require('../../common/scripts/sensor-adapter.js');
const router = require('@system.router');

const dieSrcOf = (v) => '/common/images/dice/die-' + v + '.png';
const shakeSrcOf = (frame) => '/common/images/dice/shake-' + frame + '.png';
const READY_SRC = '/common/images/dice/ready-reference.png';

export default {
  data: {
    rollState: 'READY',
    dieSrc: READY_SRC,
    jitter: false,
    sensorFallback: false,
    hint: '摇一摇手腕 或 点击屏幕',
    modeLabel: '1D6',
    resultNum: '',
    resultSub: '',
    accent: 'blue',
  },

  onInit() {
    this.sensor = sensorAdapterMod.createSensorAdapter();
    this._animTimer = null;
    this._tick = 0;
    this._unsub = null;
    try {
      this.app = this.$app.$def;
      this._unsub = this.app.store.on((what) => {
        if (what === 'rollState' || what === 'mode' || what === 'settings') {
          this.syncFromStore();
        }
      });
      this.syncFromStore();
    } catch (err) {
      // 平台的应用级服务不可用时，保留静态首页，避免整屏空白。
      console.error('home init failed: ' + String(err));
      this.sensorFallback = true;
      this.hint = '点击屏幕掷骰';
    }
  },

  onShow() {
    // 恢复前台：重置 Detector 并重新订阅传感器（第 14 节）
    this.sensorFallback = false;
    if (!this.app) {
      this.sensorFallback = true;
      this.hint = '点击屏幕掷骰';
      return;
    }
    this.app.detector.reset();
    this.sensor.start(
      (s) => this._onSample(s),
      (e) => this._onSensorError(e)
    );
    this.syncFromStore();
  },

  onHide() {
    // 离开前台：立即取消订阅、动画及未完成掷骰（FR-009 / NFR-05）。
    this.sensor.stop();
    this._stopAnim();
    if (this.app) {
      this.app.detector.reset();
      this.app.controller.cancel();
    }
  },

  onDestroy() {
    this.sensor.stop();
    this._stopAnim();
    if (this.app && this.app.controller) {
      this.app.controller.cancel();
    }
    if (this._unsub) {
      this._unsub();
    }
  },

  // ---- 交互 ----

  onTapRoll() {
    this.app.controller.trigger('tap');
  },

  goDiceSelect() {
    router.push({ uri: '/pages/dice-select' });
  },
  onSwipe(event) {
    if (this.rollState !== C.STATE_READY || !event) {
      return;
    }
    // 左滑仍保留给系统退出；首页上滑直达历史记录，右滑进入功能。
    if (event.direction === 'right') {
      router.push({ uri: '/pages/dice-select' });
    } else if (event.direction === 'up') {
      router.push({ uri: '/pages/history' });
    }
  },

  // ---- 传感器 ----

  _onSample(sample) {
    const ev = this.app.detector.pushSample(sample);
    if (ev === 'SHAKE_START') {
      this.app.controller.onShakeStart();
    } else if (ev === 'SHAKE_END') {
      this.app.controller.onShakeEnd();
    }
  },

  _onSensorError(err) {
    console.error('sensor fail: ' + JSON.stringify(err));
    this.sensorFallback = true;
    this.syncFromStore();
  },

  // ---- 渲染同步 ----

  syncFromStore() {
    const st = this.app.store.getState();
    this.modeLabel = diceEngine.modeLabel(st.mode);
    this.rollState = st.rollState;
    this.accent = st.settings && st.settings.accent ? st.settings.accent : 'blue';

    if (st.rollState === 'RESULT' && st.rollCtx && st.rollCtx.result) {
      this._stopAnim();
      const r = st.rollCtx.result;
      // 多骰明确展示每颗点数与总和，避免只显示总值而无法核对。
      this.resultNum = String(r.dice.length === 1 ? r.dice[0] : r.total);
      this.resultSub = r.dice.length > 1 ? r.dice.join(' + ') + ' = ' + r.total : '';
      this.dieSrc = dieSrcOf(r.dice[0]);
      this.hint = '点击屏幕 或 摇一摇手腕';
    } else if (st.rollState === 'SHAKING' || st.rollState === 'SETTLING') {
      this._startAnim();
      this.hint = '摇动中…';
    } else {
      this._stopAnim();
      this.jitter = false;
      this.dieSrc = READY_SRC;
      this.hint = this.sensorFallback ? '传感器不可用 · 点击掷骰' : '摇一摇手腕 或 点击掷骰';
    }
  },

  _startAnim() {
    if (this._animTimer) {
      return;
    }
    if (!this.app.store.getState().settings.animation) {
      return; // 关闭动画效果：保持静态骰面直到结果
    }
    this._animTimer = setInterval(() => {
      this._tick += 1;
      this.jitter = this._tick % 2 === 0;
      // 只切换预渲染残影帧；最终结果仅在 RESULT 进入时由 DiceEngine 生成。
      this.dieSrc = shakeSrcOf(this._tick % 4 + 1);
    }, C.ANIM_INTERVAL_MS);
  },

  _stopAnim() {
    if (this._animTimer) {
      clearInterval(this._animTimer);
      this._animTimer = null;
    }
  },

};
</script>
