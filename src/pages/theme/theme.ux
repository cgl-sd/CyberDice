<style>
@import '../../common/styles/style.css';
</style>

<template>
  <div class="page">
    <div class="topbar">
      <text class="nav-title">主题</text>
    </div>

    <div class="list">
      <div class="list-item" onclick="pickBlue">
        <text class="item-label">科技蓝</text>
        <block if="{{ settings.accent === 'blue' }}">
          <div class="check-circle theme-blue"><text class="check-glyph">✓</text></div>
        </block>
        <block if="{{ settings.accent !== 'blue' }}"><div class="check-ring"></div></block>
      </div>
      <div class="list-item" onclick="pickGreen">
        <text class="item-label">极客绿</text>
        <block if="{{ settings.accent === 'green' }}">
          <div class="check-circle theme-green"><text class="check-glyph">✓</text></div>
        </block>
        <block if="{{ settings.accent !== 'green' }}"><div class="check-ring"></div></block>
      </div>
      <div class="list-item" onclick="pickPurple">
        <text class="item-label">赛博紫</text>
        <block if="{{ settings.accent === 'purple' }}">
          <div class="check-circle theme-purple"><text class="check-glyph">✓</text></div>
        </block>
        <block if="{{ settings.accent !== 'purple' }}"><div class="check-ring"></div></block>
      </div>
    </div>
  </div>
</template>

<script>
export default {
  data: {
    settings: { vibration: true, animation: true, accent: 'blue' },
  },

  onInit() {
    this.app = this.$app.$def;
    this._unsub = this.app.store.on((what) => {
      if (what === 'settings' || what === 'load') {
        this.settings = Object.assign({}, this.app.store.getState().settings);
      }
    });
  },

  onShow() {
    this.settings = Object.assign({}, this.app.store.getState().settings);
  },

  onDestroy() {
    if (this._unsub) {
      this._unsub();
    }
  },

  pick(key) {
    this.app.store.setSetting('accent', key);
  },

  pickBlue() { this.pick('blue'); },
  pickGreen() { this.pick('green'); },
  pickPurple() { this.pick('purple'); },

};
</script>
