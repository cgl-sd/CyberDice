<style>
@import '../../common/styles/style.css';
</style>

<template>
  <div class="page">
    <!-- 与浏览器模拟器保持同一层级：标题和所有功能入口都是页面自身的直接子元素。 -->
    <div class="topbar">
      <text class="nav-title">功能</text>
    </div>

    <div class="list">
      <div class="list-item" for="{{ presets }}" onclick="selectPreset($item)">
        <text class="item-label">{{ $item }}</text>
        <div class="{{ selectedLabel === $item ? 'check-circle' : 'check-ring' }}">
          <text class="check-glyph" show="{{ selectedLabel === $item }}">✓</text>
        </div>
      </div>
      <div class="list-item" onclick="goCustom">
        <text class="item-label">自定义</text>
        <div class="{{ isCustom ? 'check-circle' : 'check-ring' }}">
          <text class="check-glyph" show="{{ isCustom }}">✓</text>
        </div>
      </div>
      <div class="list-item" onclick="goSettings">
        <text class="item-label">偏好设置</text>
        <text class="item-chevron">›</text>
      </div>
      <div class="list-item" onclick="goHistory">
        <text class="item-label">历史记录</text>
        <text class="item-chevron">›</text>
      </div>
      <div class="list-item" onclick="goAbout">
        <text class="item-label">关于</text>
        <text class="item-chevron">›</text>
      </div>
    </div>
  </div>
</template>

<script>
const router = require('@system.router');

export default {
  data: {
    presets: ['1D6', '2D6', '3D6', '1D20'],
    selectedLabel: '1D6',
    isCustom: false,
  },

  onInit() {
    this.app = this.$app;
  },

  onShow() {
    this.refresh();
  },

  refresh() {
    const mode = this.app.store.getState().mode;
    this.selectedLabel = typeof mode === 'string' ? mode : '';
    this.isCustom = typeof mode === 'object';
  },

  selectPreset(label) {
    this.app.selectMode(label);
    this.refresh();
    router.back();
  },

  goCustom() {
    router.push({ uri: '/pages/custom' });
  },

  goSettings() {
    router.push({ uri: '/pages/settings' });
  },

  goHistory() {
    router.push({ uri: '/pages/history' });
  },

  goAbout() {
    router.push({ uri: '/pages/about' });
  },

};
</script>
