<template>
  <div class="list-item" onclick="activate">
    <text class="item-label">{{ label }}</text>
    <block if="{{ selectable }}">
      <div class="{{ selected ? 'check-circle' : 'check-ring' }}">
        <text class="check-glyph" show="{{ selected }}">✓</text>
      </div>
    </block>
    <text class="item-chevron" show="{{ chevron }}">›</text>
  </div>
</template>

<script>
export default {
  props: {
    label: '',
    selectable: false,
    selected: false,
    chevron: false,
  },
  activate() {
    this.$emit('activate');
  },
};
</script>

<!-- 复用行在独立组件作用域中保有浏览器模拟器同款视觉。 -->
<style>
.list-item {
  height: 60px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #1c1c21;
  border-radius: 14px;
  margin-bottom: 10px;
  padding: 0 20px;
}

.item-label {
  font-size: 24px;
  color: #ffffff;
}

.item-chevron {
  font-size: 26px;
  color: #6f7178;
}

.check-circle {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  background-color: #2f6bed;
  align-items: center;
  justify-content: center;
}

.check-glyph {
  font-size: 18px;
  color: #ffffff;
}

.check-ring {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  border-width: 2px;
  border-color: #4a4a50;
}
</style>
